{
  "name": "pkkc",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:stg": "EXPO_PUBLIC_ENV=stg expo run:android",
    "android:ppd": "EXPO_PUBLIC_ENV=ppd expo run:android",
    "android:prd": "EXPO_PUBLIC_ENV=prd expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web",
    "build:web:stg": "EXPO_PUBLIC_ENV=stg expo export --platform web",
    "build:web:ppd": "EXPO_PUBLIC_ENV=ppd expo export --platform web",
    "build:web:prd": "EXPO_PUBLIC_ENV=prd expo export --platform web",
    "build:android:stg": "eas build --platform android --profile stg",
    "build:android:ppd": "eas build --platform android --profile ppd",
    "build:android:prd": "eas build --platform android --profile prd",
    "build:ios:stg": "eas build --platform ios --profile stg",
    "build:ios:ppd": "eas build --platform ios --profile ppd",
    "build:ios:prd": "eas build --platform ios --profile prd",
    "build:all:stg": "eas build --platform all --profile stg",
    "build:all:ppd": "eas build --platform all --profile ppd",
    "build:all:prd": "eas build --platform all --profile prd",
    "set:stg": "EXPO_PUBLIC_ENV=stg npx expo prebuild",
    "set:ppd": "EXPO_PUBLIC_ENV=ppd npx expo prebuild",
    "set:prd": "EXPO_PUBLIC_ENV=prd npx expo prebuild",
    "lint": "expo lint",
    "import:users": "node scripts/importUsers.js"
  },
  "dependencies": {
    "@expo/vector-icons": "14.1.0",
    "@gorhom/bottom-sheet": "5.2.6",
    "@react-navigation/bottom-tabs": "7.3.10",
    "@react-navigation/elements": "2.3.8",
    "@react-navigation/native": "7.1.6",
    "csv-parser": "3.2.0",
    "dayjs": "1.11.19",
    "expo": "53.0.22",
    "expo-blur": "14.1.5",
    "expo-constants": "17.1.7",
    "expo-dev-client": "5.2.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "14.1.4",
    "expo-image": "2.4.0",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "7.1.7",
    "expo-router": "5.1.5",
    "expo-splash-screen": "0.30.10",
    "expo-status-bar": "2.2.3",
    "expo-symbols": "0.4.5",
    "expo-system-ui": "5.0.11",
    "expo-web-browser": "14.2.0",
    "firebase": "12.5.0",
    "firebase-admin": "13.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "2.24.0",
    "react-native-image-viewing": "0.2.2",
    "react-native-mmkv": "4.0.0",
    "react-native-nitro-modules": "0.31.6",
    "react-native-paper": "5.14.5",
    "react-native-parsed-text": "^0.0.22",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "react-native-web": "0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@types/react": "19.0.10",
    "eslint": "9.25.0",
    "eslint-config-expo": "9.2.0",
    "typescript": "5.8.3"
  },
  "private": true
}
