{
  "cli": {
    "version": ">= 7.1.2"
  },
  "build": {
    "stg": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "stg"
      }
    },
    "stg-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "stg"
      }
    },
    "ppd": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "ppd"
      }
    },
    "prd": {
      "env": {
        "EXPO_PUBLIC_ENV": "prd"
      }
    }
  },
  "submit": {
    "production": {}
  }
}